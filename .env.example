# Optional: choose a database. Default: local SQLite in artifacts/warehouse.db.
# DATABASE_URL=postgresql+psycopg://etl:YOUR_PASSWORD@localhost:5433/retail

# Optional: retrieve raw CSV inputs from S3 and publish processed outputs to S3.
# S3_INPUT_BUCKET=your-private-input-bucket
# S3_INPUT_PREFIX=raw
# S3_OUTPUT_BUCKET=your-private-output-bucket
# S3_OUTPUT_PREFIX=curated
# S3_ENDPOINT_URL=http://localhost:9000
# AWS_DEFAULT_REGION=ap-south-1
# Use AWS_PROFILE or an IAM role. Never commit access keys.
